{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "vcs": {
    // Ensure Biome respects .gitignore entries (.pnpm-store, dist, etc.).
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    // Format and lint everything by default, but skip legacy snapshots
    // that live under legacy_html/ so we can keep the historical artifacts untouched.
    // Markdown and SVG files are written by hand and kept as they are.
    "includes": ["**", "!legacy_html", "!**/*.md", "!**/*.svg"]
  },
  "javascript": {
    // Match the legacy demo's preference for double quotes to avoid churn.
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "rules": {
      "a11y": {
        // The one jsx-a11y recommended rule that Biome does not enable by default.
        "noNoninteractiveElementInteractions": "error"
      },
      "suspicious": {
        "noUnknownAtRules": {
          "level": "error",
          "options": {
            "ignore": ["tailwind", "apply"]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/plugins/**/*.ts", "src/plugins/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["#src/**", "!#src/core/**", "!#src/shared/**", "!#src/plugins/**"],
                    "message": "Plugins can import only from #src/core/*, #src/shared/*, or #src/plugins/*."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
